rules_version = '2';

// ============================================================================
// Family Ledger — Firestore security rules
//
// Firestore has no stored procedures, so household creation and joining are
// ordinary client writes and these rules are what make them safe. The whole
// model is one invariant: you may touch a document only while you are a
// member of the household it lives under.
//
// Deploy:  firebase deploy --only firestore:rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // exists()/get() read documents directly and are not themselves filtered by
    // these rules, so a membership check here does not recurse.
    function memberPath(hid) {
      return /databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid);
    }

    function isMember(hid) {
      return signedIn() && exists(memberPath(hid));
    }

    function isOwner(hid) {
      return isMember(hid) && get(memberPath(hid)).data.role == 'owner';
    }

    function household(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }

    // ---------------------------------------------------------- households

    match /households/{hid} {
      allow read:   if isMember(hid);
      // The creator names themselves; the matching member document comes next.
      allow create: if signedIn()
                    && request.resource.data.created_by == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
      allow update: if isOwner(hid)
                    && request.resource.data.created_by == resource.data.created_by;
      allow delete: if isOwner(hid);
    }

    // --------------------------------------------------------- membership

    match /households/{hid}/members/{uid} {
      allow read: if isMember(hid);

      // Two ways in, and only two: you created the household, or you presented
      // an invite code that resolves to it. Either way you may only add
      // yourself — nobody can write another person into a household.
      allow create: if signedIn() && request.auth.uid == uid && (
        (
          request.resource.data.role == 'owner'
          && household(hid).created_by == request.auth.uid
        ) || (
          request.resource.data.role == 'member'
          && request.resource.data.invite_code is string
          && exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.invite_code))
          && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.invite_code))
               .data.household_id == hid
        )
      );

      // You may rename yourself. You may not promote yourself.
      allow update: if request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;

      allow delete: if request.auth.uid == uid || isOwner(hid);
    }

    // ------------------------------------------------------------- ledger
    // The six synced collections. 'members' is deliberately not in the list —
    // it is governed only by the block above.

    match /households/{hid}/{table}/{docId} {
      allow read, write: if isMember(hid)
        && table in ['accounts', 'categories', 'people', 'transactions', 'budgets', 'rules'];
    }

    // ------------------------------------------------------- invite codes
    // Readable by any signed-in user, because redeeming a code means resolving
    // it before you are a member. The code is the invitation; it maps to a
    // household id and nothing else.

    match /inviteCodes/{code} {
      allow get:    if signedIn();
      allow list:   if false;                      // no enumerating codes
      allow create: if isMember(request.resource.data.household_id)
                    && request.resource.data.created_by == request.auth.uid;
      allow update: if false;
      allow delete: if isOwner(resource.data.household_id);
    }

    // -------------------------------------------------- per-user index
    // Each person's own list of households, so the app never has to query
    // across every household in the project to find theirs.

    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
