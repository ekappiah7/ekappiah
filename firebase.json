{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "expenses/firebase/**",
      "**/*.sh",
      "**/package*.json"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/expenses/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/expenses/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/expenses/**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      },
      {
        "source": "/expenses/vendor/firebase/*.js",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "firestore": {
    "rules": "expenses/firebase/firestore.rules",
    "indexes": "expenses/firebase/firestore.indexes.json"
  }
}
